# =====================================================================
# Patent Intelligence (Agentic RAG) — environment configuration
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
# =====================================================================

# --- Application ---
# Options: development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- PostgreSQL (used by docker-compose AND the backend) ---
POSTGRES_USER=patent_rag
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=patent_rag
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg://patent_rag:change_me_local_only@localhost:5434/patent_rag
TEST_DATABASE_URL=postgresql+psycopg://patent_rag:change_me_local_only@localhost:5434/patent_rag_test
# Experiments (Phase 9) use a separate database: the runner wipes and re-ingests its corpus
EVAL_DATABASE_URL=postgresql+psycopg://patent_rag:change_me_local_only@localhost:5434/patent_rag_eval

# --- Uploads ---
MAX_UPLOAD_MB=25
UPLOAD_DIR=data/uploads
MAX_PDF_PAGES=500

# --- Chunking ---
# section_aware = split by patent section, one chunk per claim (default)
# fixed         = plain sliding window (baseline for Experiment B)
CHUNKING_STRATEGY=section_aware
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=60

# --- LLM (any OpenAI-compatible endpoint: OpenAI, Groq, OpenRouter, Ollama...) ---
# LLM_PROVIDER=fake returns canned answers so you can develop without paying for API calls.
# Options: fake | openai_compatible
LLM_PROVIDER=fake
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=120
# "none" disables slow "thinking" in reasoning models (e.g. qwen3 on Ollama). Blank = not sent.
LLM_REASONING_EFFORT=
# USD per 1M tokens, from your provider's price page (0 for local models)
LLM_PRICE_INPUT_PER_1M=0
LLM_PRICE_OUTPUT_PER_1M=0
# Free local option (Ollama):
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen3:8b
#   LLM_REASONING_EFFORT=none

# --- Embeddings ---
# local = runs BGE-M3 on your machine (free; needs requirements-ml.txt; ~2.3 GB download on first use)
# fake  = deterministic hash vectors, for tests / offline development only
# Options: fake | local | openai_compatible
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=BAAI/bge-m3
# Must match the model's output size. Changing it requires a new DB migration.
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
# Only for openai_compatible; leave blank to reuse LLM_BASE_URL / LLM_API_KEY
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Reranker (cross-encoder) ---
RERANKER_ENABLED=false
# Options: local | fake
RERANKER_PROVIDER=local
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Retrieval ---
# Options: hybrid | vector | keyword
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_K=30
RRF_K=60
# Below this best vector similarity (and no keyword match) -> "insufficient evidence", no LLM call.
# 0.35 suits BGE-M3 on our samples; to be calibrated in Phase 9.
RETRIEVAL_MIN_SIMILARITY=0.35
MAX_CONTEXT_TOKENS=3000

# --- Agent ---
# Pipeline used by /ask unless the request says otherwise: agentic | baseline
DEFAULT_PIPELINE=agentic
# How questions are classified: auto (LLM if a real LLM is configured) | rules | llm
AGENT_PLANNER=auto
# "Find similar" imports this many top search results as evidence
AGENT_SIMILAR_IMPORT_LIMIT=3
# Fallback attempts when evidence is insufficient (bounds cost/latency)
AGENT_MAX_RECOVERIES=1
# select: the agent chooses tools | all: every available tool on every question (Experiment F)
AGENT_TOOL_POLICY=select

# --- Claim-level verification (hallucination detection) ---
# off | report (verify and show) | regenerate (also rewrite low-grounding answers; agent only)
VERIFY_MODE=regenerate
# auto (NLI if sentence-transformers is installed) | nli | llm_judge | lexical
VERIFIER_METHOD=auto
# ~280 MB, downloaded on first use. Larger/stricter alternative: cross-encoder/nli-deberta-v3-base
VERIFIER_NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
GROUNDING_THRESHOLD=0.8
MAX_REGENERATIONS=1

# --- Patent data sources (leave blank to disable a source) ---
EPO_OPS_KEY=
EPO_OPS_SECRET=
USPTO_API_KEY=
LENS_API_TOKEN=
EPO_OPS_BASE_URL=https://ops.epo.org/3.2
PATENT_HTTP_TIMEOUT_SECONDS=30
# true = add a source of SYNTHETIC patents (country "XX") to try the UI without keys.
# Never enable for experiments.
PATENT_DEMO_SOURCE=false

# --- Cost control ---
# Cache external patent API responses for this many hours
PATENT_CACHE_TTL_HOURS=168

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# --- Hardening (Phase 11) ---
# Requests per minute (behind the Next.js proxy: one shared budget for all browser traffic)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LLM_PER_MINUTE=20
RATE_LIMIT_INGEST_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=600
# true ONLY behind a reverse proxy you control that overwrites X-Forwarded-For
TRUST_PROXY_HEADERS=false
MAX_JSON_BODY_KB=256

# --- Docker full stack (docker compose --profile app up -d --build) ---
# Ollama running on this machine, seen from inside the API container:
# DOCKER_LLM_BASE_URL=http://host.docker.internal:11434/v1
# INSTALL_ML=true      # bake PyTorch into the API image (local BGE-M3 / NLI / reranker)
# API_PORT=8000
# WEB_PORT=3000

# --- Accounts (separate database for users and login sessions) ---
AUTH_DATABASE_URL=postgresql+psycopg://patent_rag:change_me_local_only@localhost:5434/patent_rag_auth
AUTH_TEST_DATABASE_URL=postgresql+psycopg://patent_rag:change_me_local_only@localhost:5434/patent_rag_auth_test
# false = single-user mode without login (everything belongs to one local user)
AUTH_REQUIRED=true
SESSION_DAYS=14
# true when served over HTTPS
SESSION_COOKIE_SECURE=false
# Check patent watches every N hours inside the API (0 = on demand / cron only)
WATCH_CHECK_INTERVAL_HOURS=0
